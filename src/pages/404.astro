---
/**
 * 404 Not Found Page - Custom neobrutalist error page with mascot and navigation links.
 */
import PageLayout from "../layouts/PageLayout.astro";
import { Mascot } from "../components/react/Mascot";
import { StaggerText } from "../components/react/motion";
import { ArrowLeft, Home, Search } from "lucide-react";
---

<PageLayout
  title="404 - Page Not Found · Rohit Gautam"
  description="The page you are looking for does not exist or has been moved."
>
  <section class="container-page flex min-h-[70vh] flex-col items-center justify-center py-20 text-center">
    <div class="relative">
      <span aria-hidden="true" class="tape-strip absolute -top-4 -left-6 h-6 w-28 -rotate-12 rounded-[2px]"></span>
      <div class="inline-flex items-center justify-center rounded-3xl border-[3px] border-hairline bg-yellow px-8 py-4 shadow-hard">
        <span class="font-display text-6xl font-extrabold tracking-tighter md:text-8xl">404</span>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <Mascot className="size-32 text-hairline" wave client:visible />
    </div>

    <h1 class="mt-6 font-display text-3xl font-extrabold md:text-5xl">
      <StaggerText text="Lost in the digital void" client:load />
    </h1>

    <p class="mt-4 max-w-md text-base leading-relaxed text-foreground/75 md:text-lg">
      The route you followed doesn't exist, was moved, or got refactored out of existence.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full border-[3px] border-hairline bg-lavender px-6 py-3 font-display text-sm font-extrabold shadow-hard transition-transform hover:-translate-y-0.5"
      >
        <Home className="size-4" /> Return to Homepage
      </a>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-full border-[3px] border-hairline bg-card px-6 py-3 font-display text-sm font-extrabold shadow-hard-sm transition-transform hover:-translate-y-0.5"
      >
        Read the Blog
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-full border-[3px] border-hairline bg-mint px-6 py-3 font-display text-sm font-extrabold shadow-hard-sm transition-transform hover:-translate-y-0.5"
      >
        Get in Touch
      </a>
    </div>
  </section>
</PageLayout>
