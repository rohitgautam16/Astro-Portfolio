---
/**
 * Resume Page - Online resume and PDF download.
 */
import PageLayout from "../layouts/PageLayout.astro";
import { Download, Mail, MapPin, Phone } from "lucide-react";
import { profile, resume } from "../data/site";
import { Doodle, Sticker } from "../components/react/decor";
import { Reveal, StaggerText } from "../components/react/motion";
import { TechGlyph } from "../components/react/tech-icons";
---

<PageLayout
  title="Resume - Rohit Gautam, Full Stack Software Engineer"
  description="Resume of Rohit Gautam: full stack software engineering with React.js and Node.js, Cloudflare edge apps, AI automation and Oracle Cloud certifications."
>
  <section class="container-page -mt-20 pt-28 pb-14 md:-mt-24 md:pt-36 md:pb-20">
    <header class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-6 sm:flex sm:flex-wrap sm:justify-between">
      <div class="min-w-0">
        <p class="hand text-2xl print:hidden">resume</p>
        <h1 class="mt-2 font-display text-[2.5rem] leading-[0.94] font-extrabold md:text-6xl">
          <StaggerText text={resume.name} client:load />
        </h1>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.24em] text-muted-foreground">
          {resume.headline}
        </p>
      </div>
      <a
        href={profile.resumeUrl}
        download
        class="inline-flex shrink-0 items-center gap-2 rounded-full border-[3px] border-hairline bg-yellow px-5 py-3 font-display text-sm font-extrabold shadow-hard transition-transform hover:-translate-y-0.5 print:hidden"
      >
        <Download className="size-4" /> Download PDF
      </a>
    </header>

    <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
      <a class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4" href={`mailto:${profile.email}`}>
        <Mail className="size-4 shrink-0" /> {profile.email}
      </a>
      <a class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4" href={`tel:${resume.phone.replace(/\s/g, "")}`}>
        <Phone className="size-4 shrink-0" /> {resume.phone}
      </a>
      <a class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4" href={profile.github} target="_blank" rel="noreferrer">
        <TechGlyph name="GitHub" className="size-4 shrink-0" client:load /> GitHub
      </a>
      <a class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4" href={profile.linkedin} target="_blank" rel="noreferrer">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.66 1.66 0 0 0-1.66 1.66 1.66 1.66 0 0 0 1.66 1.66 1.66 1.66 0 0 0 1.66-1.66 1.66 1.66 0 0 0-1.66-1.66Z" />
        </svg> LinkedIn
      </a>
      <span class="inline-flex items-center gap-2 text-muted-foreground">
        <MapPin className="size-4 shrink-0" /> {resume.location}
      </span>
    </div>

    <Reveal client:visible>
      <div class="relative mt-10 rounded-[26px] border-[3px] border-hairline bg-mint p-6 shadow-hard md:p-8">
        <span aria-hidden="true" class="tape-strip absolute -top-3 left-10 h-5 w-24 -rotate-6 rounded-[2px]"></span>
        <p class="font-mono text-[11px] uppercase tracking-[0.24em]">summary</p>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-foreground/85 md:text-base">
          {resume.summary}
        </p>
      </div>
    </Reveal>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.35fr_0.65fr] lg:gap-14">
      <div class="flex flex-col gap-12 md:gap-16">
        <Reveal client:visible>
          <h2 class="flex items-center gap-3 font-display text-2xl font-extrabold">
            <Doodle name="star" fill className="size-5 text-yellow" client:load /> Experience
          </h2>
          <div class="mt-6 flex flex-col gap-6">
            {resume.experience.map((role) => (
              <div
                class="relative rounded-2xl border-[3px] border-hairline bg-card p-6 shadow-hard-sm"
              >
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <p class="font-display text-lg font-extrabold">
                    {role.role} · {role.company}
                  </p>
                  <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
                    {role.period}
                  </p>
                </div>
                <ul class="mt-4 space-y-2.5 text-sm text-foreground/80">
                  {role.achievements.map((item: string) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </Reveal>

        <Reveal client:visible>
          <h2 class="flex items-center gap-3 font-display text-2xl font-extrabold">
            <Doodle name="sparkle" fill className="size-5 text-lavender" client:load /> Projects
          </h2>
          <div class="mt-6 flex flex-col gap-6">
            {resume.projects.map((project) => (
              <div
                class="rounded-2xl border-[3px] border-hairline bg-surface p-6 shadow-hard-sm"
              >
                <p class="font-display text-lg font-extrabold">{project.title}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {project.stack.map((tech: string) => (
                    <span
                      class="rounded-full border-2 border-hairline bg-card px-2.5 py-1 font-mono text-[10px] uppercase tracking-widest"
                    >
                      {tech}
                    </span>
                  ))}
                </div>
                <ul class="mt-4 space-y-2.5 text-sm text-foreground/80">
                  {project.points.map((point: string) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </Reveal>
      </div>

      <div class="flex flex-col gap-10 md:gap-12">
        <Reveal client:visible>
          <h2 class="font-display text-2xl font-extrabold">Technical skills</h2>
          <div class="mt-5 flex flex-col gap-4">
            {resume.skills.map((group) => (
              <div
                class="rounded-2xl border-[3px] border-hairline bg-card p-4 shadow-hard-sm"
              >
                <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted-foreground">
                  {group.category}
                </p>
                <p class="mt-1.5 text-sm leading-relaxed">{group.items.join(" · ")}</p>
              </div>
            ))}
          </div>
        </Reveal>

        <Reveal client:visible>
          <h2 class="font-display text-2xl font-extrabold">Certifications</h2>
          <ul class="mt-5 flex flex-col gap-3">
            {resume.certifications.map((cert) => (
              <li
                class="rounded-2xl border-[3px] border-hairline bg-peach p-4 text-sm shadow-hard-sm"
              >
                <span class="font-semibold">{cert.title}</span>
                <span class="mt-1 block text-xs text-foreground/70">{cert.org}</span>
              </li>
            ))}
          </ul>
        </Reveal>

        <Reveal client:visible>
          <div class="flex flex-wrap gap-2.5 pt-2">
            <Sticker tone="yellow" rotate={-3} client:load>Open to work</Sticker>
            <Sticker tone="sky" rotate={2} client:load>Remote friendly</Sticker>
          </div>
        </Reveal>
      </div>
    </div>
  </section>
</PageLayout>
