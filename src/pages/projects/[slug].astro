---
/**
 * Project Detail Page — Dynamic case study route.
 */
import PageLayout from "../../layouts/PageLayout.astro";
import { ArrowLeft, ArrowRight } from "lucide-react";
import { projects } from "../../data/site";
import { Badge, Doodle, ScribbleDivider } from "../../components/react/decor";
import { Magnetic, Parallax, Reveal, StaggerText } from "../../components/react/motion";
import { TechGlyph } from "../../components/react/tech-icons";

export const prerender = true;

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const project = projects.find((item) => item.slug === slug);

if (!project) {
  return Astro.redirect("/projects");
}

const index = projects.findIndex((item) => item.slug === project.slug);
const next = projects[(index + 1) % projects.length]!;
---

<PageLayout
  title={`${project.title} — case study by Rohit Gautam`}
  description={project.summary}
>
  <article>
    <section class="container-page pt-10 pb-12 md:pt-14">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm font-semibold underline decoration-[3px] underline-offset-4"
      >
        <ArrowLeft className="size-4" /> All projects
      </a>

      <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_0.6fr] lg:items-end">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.24em] text-muted-foreground">
            {project.kind} · {project.year} · {project.status}
          </p>
          <h1 class="mt-4 font-display text-[2.5rem] leading-[0.94] font-extrabold md:text-7xl">
            <StaggerText text={project.title} client:load />
          </h1>
        </div>
        <div class="rounded-2xl border-[3px] border-hairline bg-surface p-5 shadow-hard-sm">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
            role
          </p>
          <p class="mt-1 font-display text-lg font-extrabold">{project.role}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.stack.map((tech: string) => (
              <Badge tone="paper" client:load>
                {tech}
              </Badge>
            ))}
          </div>
        </div>
      </div>
    </section>

    <Reveal className="container-page" client:load>
      <div class="overflow-hidden rounded-[28px] border-[3px] border-hairline shadow-hard-lg">
        <Parallax distance={26} className="aspect-16/9 w-full bg-surface" client:load>
          <img
            src={project.image}
            alt={`${project.title} interface`}
            width={1600}
            height={900}
            decoding="async"
            class="size-full scale-110 object-cover"
          />
        </Parallax>
      </div>
    </Reveal>

    <section class="container-page py-20 md:py-28">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-12">
          <Reveal client:visible>
            <p class="text-xl leading-relaxed font-medium md:text-2xl">{project.overview}</p>
          </Reveal>
          <Reveal client:visible>
            <div class="rounded-2xl border-[3px] border-hairline bg-peach p-7 shadow-hard">
              <p class="hand text-2xl">the problem</p>
              <p class="mt-3 leading-relaxed">{project.problem}</p>
            </div>
          </Reveal>
          <Reveal client:visible>
            <div class="rounded-2xl border-[3px] border-hairline bg-mint p-7 shadow-hard">
              <p class="hand text-2xl">what I built</p>
              <p class="mt-3 leading-relaxed">{project.solution}</p>
            </div>
          </Reveal>
        </div>

        <Reveal delay={0.08} className="lg:sticky lg:top-28 lg:h-fit" client:visible>
          <div class="rounded-2xl border-[3px] border-hairline bg-card p-7 shadow-hard">
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground">
              architecture
            </p>
            <ul class="mt-5 space-y-4">
              {project.architecture.map((item: string) => (
                <li class="flex gap-3 text-sm leading-relaxed text-foreground/80">
                  <Doodle name="star" fill className="mt-0.5 size-3.5 shrink-0" client:load />
                  {item}
                </li>
              ))}
            </ul>
            {project.github ? (
              <a
                href={project.github}
                target="_blank"
                rel="noreferrer"
                class="mt-7 inline-flex items-center gap-2 rounded-full border-[3px] border-hairline bg-yellow px-5 py-2.5 font-display text-sm font-extrabold shadow-hard-sm transition-transform hover:-translate-y-0.5"
              >
                <TechGlyph name="GitHub" className="size-4" client:load /> GitHub
              </a>
            ) : null}
          </div>
        </Reveal>
      </div>

      <ScribbleDivider className="my-16" client:visible />

      <Reveal client:visible>
        <h2 class="font-display text-3xl leading-[0.95] font-extrabold md:text-5xl">
          Engineering highlights
        </h2>
      </Reveal>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {project.highlights.map((item, i: number) => (
          <Reveal delay={i * 0.07} client:visible>
            <div
              style={`transform: rotate(${i % 2 ? 1 : -1}deg)`}
              class="poke h-full rounded-2xl border-[3px] border-hairline bg-surface p-6 shadow-hard"
            >
              <p class="font-mono text-xs text-muted-foreground">0{i + 1}</p>
              <h3 class="mt-3 font-display text-lg font-extrabold">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-foreground/75">{item.body}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </section>

    <section class="container-page pb-24">
      <Reveal client:visible>
        <a
          href={`/projects/${next.slug}`}
          class="group flex flex-wrap items-center justify-between gap-6 rounded-[28px] border-[3px] border-hairline bg-lavender p-8 shadow-hard md:p-12"
        >
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.24em]">next project</p>
            <p class="mt-3 font-display text-2xl font-extrabold md:text-4xl">{next.title}</p>
          </div>
          <Magnetic client:idle>
            <span class="grid size-14 place-items-center rounded-full border-[3px] border-hairline bg-card transition-transform duration-300 group-hover:rotate-12">
              <ArrowRight className="size-5" />
            </span>
          </Magnetic>
        </a>
      </Reveal>
    </section>
  </article>
</PageLayout>
